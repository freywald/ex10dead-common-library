#!/bin/bash

function ex10dead_common_library_setup() {
	echo "setting up ex10dead_common_library"


	local real
	real="$(realpath -- "$__ex10dead_common_library_library_path/library/common")" || return 1
	sourced_files["$real"]=1

	cd "$__ex10dead_common_library_library_path/"

	echo "setting up ex10dead_common_library"
}

register_handler "ex10dead_common_library" "ex10dead_common_library_setup"
